[Unit]
Description=Telegram flight search commands
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=flightwatch
Group=flightwatch
WorkingDirectory=/opt/flightwatch
ExecStart=/usr/bin/python3 /opt/flightwatch/bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flightwatch/data
UMask=0077

[Install]
WantedBy=multi-user.target
